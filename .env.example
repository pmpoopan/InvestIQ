# Copy to .env and fill in. Never commit real keys.

GROQ_API_KEY=
# Groq shut down llama-3.3-70b-versatile for free/dev tiers on 2026-08-16.
# Default: openai/gpt-oss-120b (Groq's documented replacement).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.6-27b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=5
MIN_RELEVANCE=0.28
